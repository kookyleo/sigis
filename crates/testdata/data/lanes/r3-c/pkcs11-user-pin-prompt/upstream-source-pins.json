    "full_decorated_source": "@pytest.mark.hsm(platform='softhsm')\n@pytest.mark.algo(algo='ed25519')\ndef test_cli_addsig_pkcs11_with_setup_and_pin_prompt(\n    cli_runner,\n    post_validate,\n    p11_config,\n    pinentry_context,\n):\n    cfg = _pkcs11_setup_config_pull_certs(p11_config)\n    _write_config(cfg)\n\n    result = cli_runner.invoke(\n        cli_root,\n        [\n            'sign',\n            'addsig',\n            '--field',\n            'Sig1',\n            'pkcs11',\n            '--p11-setup',\n            'test',\n            INPUT_PATH,\n            SIGNED_OUTPUT_PATH,\n        ],\n        obj=pinentry_context,\n    )\n    assert not result.exception, result.output\n",
    "decorators": [
      "pytest.mark.hsm(platform='softhsm')",
      "pytest.mark.algo(algo='ed25519')"
    ],
    "assertions": [
      "assert not result.exception, result.output"
    ],
